<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0C0E"
    tools:context=".ui.DesktopActivity">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_win12"
        android:contentDescription="@string/wallpaper" />

    <GridLayout
        android:id="@+id/desktop_icons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="88dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="32dp"
        android:columnCount="8"
        android:alignmentMode="alignBounds"
        android:useDefaultMargins="false" />

    <LinearLayout
        android:id="@+id/start_menu_panel"
        android:layout_width="680dp"
        android:layout_height="560dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="88dp"
        android:background="@drawable/bg_glass_panel"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        android:elevation="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="\u641c\u7d22\u5e94\u7528\u3001\u8bbe\u7f6e\u548c\u6587\u6863"
                android:textColor="#8A8A8A"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u5df2\u56fa\u5b9a"
            android:textColor="#C5C5C5"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/app_list_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NEXUS WIN12"
                android:textColor="#8A8A8A"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:background="@drawable/bg_button_glass"
                android:text="@string/settings"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginEnd="10dp" />
            <TextView
                android:id="@+id/btn_power"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:background="@drawable/bg_button_glass"
                android:text="@string/power"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:paddingBottom="12dp"
        android:paddingHorizontal="24dp">

        <LinearLayout
            android:id="@+id/taskbar"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal|bottom"
            android:background="@drawable/bg_taskbar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:elevation="16dp"
            android:minWidth="320dp">

            <ImageView
                android:id="@+id/start_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_start"
                android:padding="12dp"
                android:background="@drawable/bg_taskbar_icon"
                android:contentDescription="@string/start"
                android:scaleType="fitCenter" />

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:background="#33FFFFFF"
                android:layout_marginHorizontal="8dp" />

            <LinearLayout
                android:id="@+id/status_bar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_taskbar_icon"
                android:minWidth="88dp">

                <TextView
                    android:id="@+id/clock_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    tools:text="14:32" />

                <TextView
                    android:id="@+id/date_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#C5C5C5"
                    android:textSize="11sp"
                    tools:text="11/12" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
