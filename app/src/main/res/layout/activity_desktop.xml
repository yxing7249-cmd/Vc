<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView android:id="@+id/wallpaper" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/wallpaper_win12" android:contentDescription="@null" />

    <GridLayout android:id="@+id/desktop_icons" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="28dp" android:layout_marginTop="28dp" android:layout_marginEnd="28dp" android:layout_marginBottom="70dp" android:columnCount="8" android:alignmentMode="alignBounds" android:useDefaultMargins="false" />

    <LinearLayout android:id="@+id/start_menu_panel" android:layout_width="720dp" android:layout_height="520dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="62dp" android:background="@drawable/bg_start_menu" android:orientation="horizontal" android:visibility="gone" android:elevation="20dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="12dp">
                <TextView android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:background="@drawable/bg_theme_btn" android:text="A" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Administrator" android:textColor="#EEEEEE" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u53ef\u7528" android:textColor="#AAAAAA" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="40dp" android:background="@drawable/bg_search" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:text="\u5728\u8fd9\u91cc\u8f93\u5165\u4f60\u8981\u641c\u7d22\u7684\u5185\u5bb9" android:textColor="#AAAAAA" android:textSize="13sp" android:layout_marginBottom="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u6240\u6709\u5e94\u7528" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginBottom="6dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/app_list_recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never" />
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginVertical="20dp" android:background="#333333" />
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.85" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u5df2\u56fa\u5b9a" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginBottom="10dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:id="@+id/folder_docs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:background="@drawable/bg_list_item">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_folder" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u6587\u6863" android:textColor="#EEEEEE" android:textSize="12sp" android:layout_marginTop="4dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/folder_pics" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:background="@drawable/bg_list_item">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_folder" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u56fe\u7247" android:textColor="#EEEEEE" android:textSize="12sp" android:layout_marginTop="4dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/folder_music" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp" android:background="@drawable/bg_list_item">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_folder" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u97f3\u4e50" android:textColor="#EEEEEE" android:textSize="12sp" android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" android:layout_marginVertical="14dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u63a8\u8350\u7684\u9879\u76ee" android:textColor="#AAAAAA" android:textSize="12sp" android:layout_marginBottom="8dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="\u79d1\u5b66\u5730\u4f7f\u7528\u74f6\u76d6.pptx" android:textColor="#EEEEEE" android:textSize="13sp" android:paddingVertical="6dp" android:background="@drawable/bg_list_item" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="\u53ef\u53e3\u53ef\u4e50\u74f6\u76d6.jpg" android:textColor="#EEEEEE" android:textSize="13sp" android:paddingVertical="6dp" android:background="@drawable/bg_list_item" />
            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end">
                <TextView android:id="@+id/btn_settings" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:paddingHorizontal="16dp" android:background="@drawable/bg_list_item" android:text="\u8bbe\u7f6e" android:textColor="#EEEEEE" android:textSize="13sp" android:layout_marginEnd="8dp" />
                <TextView android:id="@+id/btn_power" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:paddingHorizontal="16dp" android:background="@drawable/bg_theme_btn" android:text="\u7535\u6e90" android:textColor="#FFFFFF" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/panel_control_center" />

    <LinearLayout android:id="@+id/dock_box" android:layout_width="match_parent" android:layout_height="56dp" android:layout_gravity="bottom" android:gravity="center_horizontal|bottom" android:orientation="horizontal" android:paddingBottom="10dp" android:paddingHorizontal="8dp">
        <LinearLayout android:id="@+id/widgets_btn" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_dock" android:gravity="center" android:layout_marginEnd="6dp" android:elevation="12dp">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_widgets" android:contentDescription="widgets" />
        </LinearLayout>
        <LinearLayout android:id="@+id/taskbar" android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/bg_dock" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="6dp" android:elevation="12dp" android:minWidth="200dp">
            <ImageView android:id="@+id/start_button" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/ic_start" android:background="@drawable/bg_dock_btn" android:contentDescription="start" android:scaleType="fitCenter" />
            <LinearLayout android:id="@+id/dock_apps" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/dock_control" android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/bg_dock" android:orientation="horizontal" android:gravity="center" android:paddingHorizontal="10dp" android:layout_marginStart="6dp" android:elevation="12dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_wifi" android:layout_marginEnd="6dp" android:contentDescription="@null" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_volume" android:contentDescription="@null" />
        </LinearLayout>
        <LinearLayout android:id="@+id/status_bar" android:layout_width="wrap_content" android:layout_height="44dp" android:background="@drawable/bg_dock" android:orientation="vertical" android:gravity="center" android:paddingHorizontal="12dp" android:layout_marginStart="6dp" android:elevation="12dp" android:minWidth="88dp">
            <TextView android:id="@+id/clock_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#EEEEEE" android:textSize="13sp" android:textStyle="bold" tools:text="12:34" />
            <TextView android:id="@+id/date_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAAAAA" android:textSize="10sp" tools:text="11/12" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
